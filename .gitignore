.DS_Store
__pycache__/
*.py[cod]

# Runtime state and logs generated by apx
state/**
!state/.gitkeep
*.log
*.pid
*.adopted.pid

# Dashboard build dependencies are local; compiled static assets are produced
# deliberately into share/dashboard for the release/install flow.
dashboard/node_modules/

# Local runtime backups created by install.sh
*.bak.*

# Local/private config overrides
*.local
.env
.env.*

# Build outputs (dist/apx.sh + sha256) are release artifacts, not committed.
dist/
dashboard/test-results/
dashboard/playwright-report/
