#!/usr/bin/env python3
"""Validate and evaluate LeanRelay's non-executable advisory policy."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import sys
from pathlib import Path
from typing import Any


ALLOWED_SEVERITIES = {"info", "recommended", "warning", "critical"}
ALLOWED_CATEGORIES = {"capability", "correctness", "observability", "security", "versions"}
ALLOWED_SETTINGS = {"PXPIPE_MODELS"}
ALLOWED_CONDITIONS = {"list_contains"}
ALLOWED_ACTIONS = {"remove_list_value"}
ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{2,79}$")
MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]*$")


class PolicyError(ValueError):
    pass


def _exact_keys(value: dict[str, Any], allowed: set[str], where: str) -> None:
    unknown = sorted(set(value) - allowed)
    if unknown:
        raise PolicyError(f"{where} contains unsupported fields: {', '.join(unknown)}")


def _text(value: Any, where: str, limit: int) -> str:
    if not isinstance(value, str) or not value or len(value) > limit or any(ord(ch) < 32 for ch in value):
        raise PolicyError(f"{where} must be non-empty printable text up to {limit} characters")
    return value


def validate_policy(data: Any) -> dict[str, Any]:
    if not isinstance(data, dict):
        raise PolicyError("policy root must be an object")
    _exact_keys(data, {"schema_version", "revision", "generated_at", "expires_at", "advisories"}, "policy")
    if data.get("schema_version") != 1:
        raise PolicyError("unsupported schema_version")
    revision = data.get("revision")
    if not isinstance(revision, int) or revision < 1:
        raise PolicyError("revision must be a positive integer")
    generated_text = _text(data.get("generated_at"), "generated_at", 40)
    expires_text = _text(data.get("expires_at"), "expires_at", 40)
    try:
        generated = dt.datetime.fromisoformat(generated_text.replace("Z", "+00:00"))
        expires = dt.datetime.fromisoformat(expires_text.replace("Z", "+00:00"))
    except ValueError as exc:
        raise PolicyError("policy timestamps must use ISO-8601") from exc
    now = dt.datetime.now(dt.timezone.utc)
    if generated.tzinfo is None or expires.tzinfo is None or expires <= generated:
        raise PolicyError("policy timestamps must be timezone-aware and ordered")
    if expires <= now:
        raise PolicyError("policy is expired")
    advisories = data.get("advisories")
    if not isinstance(advisories, list) or len(advisories) > 100:
        raise PolicyError("advisories must be an array with at most 100 entries")
    seen: set[str] = set()
    for index, item in enumerate(advisories):
        where = f"advisories[{index}]"
        if not isinstance(item, dict):
            raise PolicyError(f"{where} must be an object")
        _exact_keys(item, {"id", "guidance_version", "severity", "category", "title", "impact", "condition", "remediation"}, where)
        advisory_id = _text(item.get("id"), f"{where}.id", 80)
        if not ID_RE.fullmatch(advisory_id) or advisory_id in seen:
            raise PolicyError(f"{where}.id is invalid or duplicated")
        seen.add(advisory_id)
        if not isinstance(item.get("guidance_version"), int) or item["guidance_version"] < 1:
            raise PolicyError(f"{where}.guidance_version must be positive")
        if item.get("severity") not in ALLOWED_SEVERITIES:
            raise PolicyError(f"{where}.severity is unsupported")
        if item.get("category") not in ALLOWED_CATEGORIES:
            raise PolicyError(f"{where}.category is unsupported")
        _text(item.get("title"), f"{where}.title", 120)
        _text(item.get("impact"), f"{where}.impact", 500)
        condition = item.get("condition")
        if not isinstance(condition, dict):
            raise PolicyError(f"{where}.condition must be an object")
        _exact_keys(condition, {"type", "setting", "value"}, f"{where}.condition")
        if condition.get("type") not in ALLOWED_CONDITIONS or condition.get("setting") not in ALLOWED_SETTINGS:
            raise PolicyError(f"{where}.condition is unsupported")
        if not MODEL_RE.fullmatch(str(condition.get("value", ""))):
            raise PolicyError(f"{where}.condition.value is invalid")
        remediation = item.get("remediation")
        if not isinstance(remediation, dict):
            raise PolicyError(f"{where}.remediation must be an object")
        _exact_keys(remediation, {"type", "setting", "value"}, f"{where}.remediation")
        if remediation.get("type") not in ALLOWED_ACTIONS or remediation.get("setting") not in ALLOWED_SETTINGS:
            raise PolicyError(f"{where}.remediation is unsupported")
        if not MODEL_RE.fullmatch(str(remediation.get("value", ""))):
            raise PolicyError(f"{where}.remediation.value is invalid")
    return data


def load_policy(path: Path) -> dict[str, Any]:
    try:
        return validate_policy(json.loads(path.read_text(encoding="utf-8")))
    except (OSError, json.JSONDecodeError) as exc:
        raise PolicyError(str(exc)) from exc


def parse_config_value(path: Path, key: str) -> str:
    prefix = f"{key}="
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            if line.startswith(prefix):
                value = line[len(prefix):].strip()
                if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
                    value = value[1:-1]
                return value
    except OSError:
        return ""
    return ""


def evaluate(policy: dict[str, Any], config_path: Path) -> list[dict[str, Any]]:
    active: list[dict[str, Any]] = []
    for item in policy["advisories"]:
        condition = item["condition"]
        current = parse_config_value(config_path, condition["setting"])
        values = current.split(",") if current and current != "off" else []
        if condition["type"] == "list_contains" and condition["value"] in values:
            result = dict(item)
            remediation = item["remediation"]
            remaining = [value for value in values if value != remediation["value"]]
            result["remediation_command"] = f"apx pxpipe models set {','.join(remaining) if remaining else 'off'}"
            active.append(result)
    return active


def main() -> int:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    validate = subparsers.add_parser("validate")
    validate.add_argument("policy", type=Path)
    evaluate_parser = subparsers.add_parser("evaluate")
    evaluate_parser.add_argument("policy", type=Path)
    evaluate_parser.add_argument("--config", required=True, type=Path)
    evaluate_parser.add_argument("--format", choices=("json", "tsv"), default="json")
    args = parser.parse_args()
    try:
        policy = load_policy(args.policy)
        if args.command == "validate":
            print(json.dumps({"schema_version": policy["schema_version"], "revision": policy["revision"], "advisories": len(policy["advisories"])}, separators=(",", ":")))
        else:
            active = evaluate(policy, args.config)
            if args.format == "json":
                print(json.dumps(active, separators=(",", ":")))
            else:
                for item in active:
                    print("\t".join((item["id"], str(item["guidance_version"]), item["severity"], item["category"], item["title"], item["impact"], item["remediation_command"])))
    except PolicyError as exc:
        print(f"invalid advisory policy: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
